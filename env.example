# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Only placeholders here — no real values.

# --- BigQuery (Level 1 full rebuild) ---
# GCP project with BigQuery API enabled. You pay normal BigQuery query
# costs; filtering on block_date keeps the bill small (free tier: 1 TB/month).
GCP_PROJECT_ID=
# Path to a GCP service-account JSON key. Leave this line COMMENTED OUT
# unless you have a key file: an empty GOOGLE_APPLICATION_CREDENTIALS=
# makes Google's auth library fail looking for a file named "" instead of
# falling back to Application Default Credentials
# (`gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- NEAR Intents Explorer API (Level 1 full rebuild) ---
# JWT from the Intents partner dashboard. Required for swapper-level data
# (sub-hypothesis A) and the canonical Intents volume series.
INTENTS_EXPLORER_JWT=
# Base URL of the Intents Explorer API, from the partner dashboard/docs.
INTENTS_EXPLORER_API_URL=
# Endpoint path for the daily volume series (relative to the base URL).
# Leave empty until confirmed from the API docs — fetch.py skips the
# Intents leg with a clear message if this is unset.
INTENTS_EXPLORER_VOLUME_PATH=

# --- DefiLlama (free, no key) ---
# Slug for the Intents protocol. The expected slug is "near-intents".
# If the API 404s, check the slug at
# https://api.llama.fi/summary/dexs/<slug> and correct this value.
DEFILLAMA_INTENTS_SLUG=near-intents

# --- CoinGecko (free, keyless) ---
# Optional demo key (free signup) — raises the rate limit. Leave empty to
# use the keyless API (~5 calls/min, enough: fetch calls once and caches).
COINGECKO_API_KEY=
